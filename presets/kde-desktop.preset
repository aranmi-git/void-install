# void-install preset v1
# name: kde-desktop
# id: kde-desktop@818844b9fa853e35
# Made by void-install.sh 1.7 on 2026-11-16.
# Load it with:  bash void-install.sh --preset <this file, an https link or a name>
# Disk, passwords and users are never stored here; the installer asks for them.
FS=btrfs
ENC=luks2
GRUB_BOOT=encrypted
BOOTLOADER=grub
SWAP=zram
SWAP_SIZE=4
KERNELS=linux linux-lts
LIBC=glibc
MIRROR=https://repo-default.voidlinux.org
HOST_NAME=void
KEYMAP=us
LOCALE=en_US.UTF-8
TIMEZONE=UTC
NET=nm
DESKTOP=kde
DM=sddm
DOTS=
GPU=auto
APPS=firefox vlc libreoffice flatpak git
GAMING=
EXTRA_PKGS=chrony
XSRC_PKGS=
XSRC_SETUP=0
BS_PROGS=
BS_DOTFILES=
BS_BRANCH=
BS_SHELL=bash
BS_POWER=0
