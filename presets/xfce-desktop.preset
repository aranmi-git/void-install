# Load it with:  bash void-install.sh --preset <this file, an https link or a name>
# Disk, passwords and users are never stored here; the installer asks for them.
FS=btrfs
ENC=luks2
GRUB_BOOT=encrypted
BOOTLOADER=grub
SWAP=zram
SWAP_SIZE=4
KERNELS=linux linux-lts
LIBC=glibc
MIRROR=https://repo-default.voidlinux.org
HOST_NAME=void
KEYMAP=us
LOCALE=en_US.UTF-8
TIMEZONE=UTC
NET=nm
DESKTOP=xfce
DM=lightdm
DOTS=
GPU=auto
APPS=firefox thunderbird vlc libreoffice keepassxc flatpak git htop
GAMING=
EXTRA_PKGS=chrony
XSRC_PKGS=
XSRC_SETUP=0
BS_PROGS=
BS_DOTFILES=
BS_BRANCH=
BS_SHELL=bash
BS_POWER=0
