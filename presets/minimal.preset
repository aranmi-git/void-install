# void-install preset v1
# name: minimal
# id: minimal@6d574c6ac315d064
# Made by void-install.sh 1.7 on 2026-11-16.
# Load it with:  bash void-install.sh --preset <this file, an https link or a name>
# Disk, passwords and users are never stored here; the installer asks for them.
FS=ext4
ENC=luks2
GRUB_BOOT=encrypted
BOOTLOADER=grub
SWAP=zram
SWAP_SIZE=4
KERNELS=linux-lts
LIBC=glibc
MIRROR=https://repo-default.voidlinux.org
HOST_NAME=void-server
KEYMAP=us
LOCALE=en_US.UTF-8
TIMEZONE=UTC
NET=dhcpcd
DESKTOP=none
DM=auto
DOTS=
GPU=auto
APPS=git htop neovim
GAMING=
EXTRA_PKGS=chrony openssh
XSRC_PKGS=
XSRC_SETUP=0
BS_PROGS=
BS_DOTFILES=
BS_BRANCH=
BS_SHELL=bash
BS_POWER=0
